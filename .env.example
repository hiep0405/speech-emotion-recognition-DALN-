# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN SER WAV2VEC 2.0 (DOCKER & RTX 3060)
# ==============================================================================

# 1. Cấu hình Huấn luyện
FOLD=1                          # Fold kiểm thử (1-5 hoặc all)
EPOCHS=15                       # Số epochs huấn luyện (Khuyến nghị: 15)
BATCH_SIZE=8                    # Batch size vật lý trên GPU (Tối ưu RTX 3060: 8)
GRAD_ACCUM_STEPS=4              # Tích lũy gradient (8 x 4 = Effective Batch Size 32)
LR_BACKBONE=0.00001             # Learning rate cho Transformer (1e-5)
LR_HEAD=0.0005                  # Learning rate cho Classifier Head (5e-4)
UNFREEZE_LAYERS=6               # Chỉ mở 6 tầng cuối trong 24 tầng Transformer

# 2. Cấu hình Bảo vệ Phần cứng & Tối ưu RTX 3060 (Chống hỏng máy)
GPU_MAX_TEMP=78                 # Ngưỡng nhiệt độ an toàn (°C). Vượt quá sẽ tự động tạm dừng
GPU_COOLDOWN_TEMP=70            # Nhiệt độ mục tiêu làm mát (°C) trước khi tiếp tục
GPU_MEM_FRACTION=0.88           # Giữ lại 12% VRAM để tránh treo máy OS / BSOD
USE_AMP=true                    # Bật Mixed Precision FP16 (Tăng tốc 2.5x trên Tensor Core Ampere)
GRADIENT_CHECKPOINTING=true     # Tiết kiệm 50% VRAM activation

# 3. Giám sát từ xa qua Weights & Biases (W&B) - Điền key từ https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=ser-wav2vec2-rtx3060

# 4. Giám sát từ xa & Cảnh báo qua Telegram Bot (Tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5. Cấu hình Tự động Đồng bộ & Tái Huấn luyện GitHub (Git Watcher)
GIT_BRANCH=main
SYNC_INTERVAL=60                # Chu kỳ kiểm tra GitHub (giây)
